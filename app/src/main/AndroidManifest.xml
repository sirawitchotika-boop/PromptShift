<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Floating overlay, Android 14 specialUse FGS, and direct AI API calls (Copy-only, ZERO Accessibility) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".PromptShiftApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PromptShift">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PromptShift">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compact Quick-Direction popup launched from the Floating Bubble over active apps -->
        <activity
            android:name=".ui.QuickDirectionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.PromptShift.Dialog"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Translucent Snippets & Recent 10 popup launched from the Floating Bubble -->
        <activity
            android:name=".ui.SnippetsPopupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.PromptShift.Dialog"
            android:windowSoftInputMode="adjustResize" />

        <!-- Translucent Countdown Timer popup launched from the Floating Bubble or Mini-Keyboard -->
        <activity
            android:name=".ui.TimerPopupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.PromptShift.Dialog"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- 1-frame transparent trampoline for Android 10+ background clipboard read -->
        <activity
            android:name=".clipboard.ClipboardTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PromptShift.Trampoline" />

        <receiver
            android:name=".timer.TimerAlertReceiver"
            android:exported="false" />

        <service
            android:name=".overlay.FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating prompt clipboard overlay" />
        </service>

        <!-- Banking-app-safe Mini-Keyboard for 1-tap auto-insert at cursor (ZERO Accessibility) -->
        <service
            android:name=".ime.PromptShiftImeService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/promptshift_ime_method" />
        </service>
    </application>

</manifest>
